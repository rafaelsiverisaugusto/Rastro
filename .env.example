# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API Keys). The publishable key is public by design
# (legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy service_role key): server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Session pooler) used by migrations and import scripts.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Optional: path to the Supabase root certificate (Project Settings > Database >
# SSL Configuration) so import scripts verify TLS. Without it, TLS is encrypted
# but the certificate chain is not verified.
SUPABASE_DB_CA_CERT=

# Shared demonstration account (server only). Created by npm run data:seed.
# Fictitious e-mail; use a random password of 16+ characters.
DEMO_USER_EMAIL=demo@rastro.example
DEMO_USER_PASSWORD=

# Phase 2: dossier narrative (server only)
ANTHROPIC_API_KEY=

# Phase 3: alert e-mails
RESEND_API_KEY=
